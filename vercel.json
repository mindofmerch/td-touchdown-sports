    { "source": "/api/brain", "destination": "https://cnqyxhazmctvboxaosut.supabase.co/functions/v1/yes-history-echo-public" },
    { "source": "/", "destination": "https://yes-td-vortex.jessicasalasr209.chatgpt.site/" },
